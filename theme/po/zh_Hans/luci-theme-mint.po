msgstr "记住我"

#: ucode/template/themes/mint/sysauth.ut:74
msgid "Log in"
msgstr "登录"

#: ucode/template/themes/mint/sysauth.ut:80
msgid "Sign in with Passkey"
msgstr "使用 Passkey 登录"

#: ucode/template/themes/mint/sysauth.ut:80
msgid "Passkeys are not configured on this system"
msgstr "此系统尚未配置 Passkey"

#: ucode/template/themes/mint/sysauth.ut:99
