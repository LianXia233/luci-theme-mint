#: ucode/template/themes/mint/header.ut:128
msgid "Skip to main content"
msgstr "跳转到主内容"

#: ucode/template/themes/mint/header.ut:130
msgid "Toggle navigation menu"
msgstr "切换导航菜单"

#: ucode/template/themes/mint/header.ut:135
msgid "Main navigation"
msgstr "主导航"

#: ucode/template/themes/mint/header.ut:142
msgid "Menu"
msgstr "菜单"

#: ucode/template/themes/mint/header.ut:148
msgid "System"
msgstr "系统"

#: ucode/template/themes/mint/header.ut:151
msgid "Switch color scheme"
msgstr "切换配色方案"

#: ucode/template/themes/mint/header.ut:154
msgid "Log out"
msgstr "退出登录"

#: ucode/template/themes/mint/header.ut:169
msgid "No password set!"
msgstr "尚未设置密码！"

#: ucode/template/themes/mint/header.ut:170
msgid "There is no password set on this router. Please configure a root password to protect the web interface."
msgstr "此路由器尚未设置密码。请配置 root 密码以保护 Web 界面。"

#: ucode/template/themes/mint/header.ut:172
msgid "Go to password configuration..."
msgstr "前往密码设置…"

#: ucode/template/themes/mint/header.ut:179
msgid "System running in recovery (initramfs) mode."
msgstr "系统正运行于恢复（initramfs）模式。"

#: ucode/template/themes/mint/header.ut:180
msgid "No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade"
msgstr "设置的更改不会被保存，重启后将丢失。此模式仅应用于安装固件升级"

#: ucode/template/themes/mint/header.ut:182
msgid "Go to firmware upgrade..."
msgstr "前往固件升级…"

#: ucode/template/themes/mint/header.ut:189
msgid "JavaScript required!"
msgstr "需要 JavaScript！"

#: ucode/template/themes/mint/header.ut:190
msgid "You must enable JavaScript in your browser or LuCI will not work properly."
msgstr "您必须在浏览器中启用 JavaScript，否则 LuCI 将无法正常工作。"

#: ucode/template/themes/mint/sysauth.ut:20
msgid "Welcome back! Log in to manage your network."
msgstr "可可，嗨嗨嗨~！登录以管理您的网络。"

#: ucode/template/themes/mint/sysauth.ut:28
msgid "Invalid username and/or password! Please try again."
msgstr "用户名或密码错误！请重试。"

