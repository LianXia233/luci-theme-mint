{%
	import { getuid, getspnam } from 'luci.core';
	import { getWallpapers } from 'luci.mint.wallpaper';

	const boardinfo = ubus.call('system', 'board') ?? {};

	/* Theme variant handling: since 2026-09-10 only the single "mint"
	   variant is shipped. The old mint-light / mint-dark / mintzero*
	   registrations are gone; if a stale mediaurlbase is still present it
	   is defensively mapped here so the page still opens until
	   uci-defaults rewrites it to /luci-static/mint. */
	const mediasegs = split(media ?? '', '/');
	const mediabase = mediasegs[length(mediasegs) - 1] ?? 'mint';
	const themepref = (mediabase == 'mint-dark' ? 'dark' : (mediabase == 'mint-light' ? 'light' : 'system'));

	/* Wallpaper settings from UCI; `uci` is the cursor provided by the
	   LuCI dispatcher environment. */
	const wp = uci.get_all('mint', 'wallpaper') ?? {};

	/* Wallpaper configuration for every page (login + admin UI). */
	let wallpaper = { enabled: true, pc: null, mobile: null };
	let wallpaper_error = null;

	try {
		wallpaper = getWallpapers();
	}
	catch (e) {
		wallpaper = { enabled: true, pc: null, mobile: null };
		try { wallpaper_error = e.message ?? type(e); } catch (e2) { wallpaper_error = type(e); }
	}

	http.prepare_content('text/html; charset=UTF-8');

	/* Asset cache revision. MUST match the ?v= of the @import lines in
	   cascade.css: the static files are served with long-lived cache
	   headers, so a revision bump is the only reliable way to make
	   browsers pick up an updated stylesheet. Bump it whenever any file
	   under htdocs/luci-static/mint changes. */
	const MINT_ASSET_REV = '20260913';
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-theme="{{ themepref }}">
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${boardinfo.hostname ?? '?'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
		{% if (themepref == 'system'): %}
		<script>
			(function() {
				/* Honor a user-chosen override first; fall back to the OS
				   preference only when no explicit choice was stored. */
				var saved = null;
				try { saved = localStorage.getItem('mz-theme'); } catch (e) {}
				var mq = window.matchMedia('(prefers-color-scheme: dark)');
				var apply = function() {
					var mode = saved;
					if (mode !== 'light' && mode !== 'dark')
						mode = (mq.matches ? 'dark' : 'light');
					document.documentElement.setAttribute('data-theme', mode);
				};
				if (saved === 'light' || saved === 'dark') {
					document.documentElement.setAttribute('data-theme', saved);
				} else {
					mq.addEventListener ? mq.addEventListener('change', apply) : mq.addListener(apply);
					apply();
				}
			})();
		</script>
	{% endif %}
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="darkreader-lock">
		{% if (themepref == 'light'): %}
		<meta name="theme-color" content="#f5f6f8">
		{% else %}
		<meta name="theme-color" content="#0f172a">
		{% endif %}
		<link rel="stylesheet" href="{{ media }}/cascade.css?v={{ MINT_ASSET_REV }}">
		<link rel="icon" href="{{ media }}/favicon/favicon.svg" sizes="any" type="image/svg+xml">
		<link rel="icon" href="{{ media }}/favicon/favicon-48.png" sizes="48x48">
		<link rel="apple-touch-icon" href="{{ media }}/favicon/favicon-180.png">
		{% if (dispatched?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ dispatched.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
		<script>
			/* Expose wallpaper settings to the frontend (server-rendered,
			   no extra request). */
			window.mintWallpaper = {
				enabled: {{ (wp.enabled == '0' || wallpaper.enabled == false) ? 'false' : 'true' }},
				overlay: {{ sprintf('%J', wallpaper.overlay ?? '0.45') }},
				blur: {{ sprintf('%J', wallpaper.blur ?? '0') }},
				/* Missing ui_random means the uci default ('0', see
				   wallpaper.uc "?? '0'"): admin-page random wallpaper is
				   OFF by default (OT-09), and a trimmed/corrupted
				   /etc/config/mint must silently follow that same default
				   instead of diverging. */
				ui_random: {{ ((wp.ui_random ?? '0') == '1') ? 'true' : 'false' }},
				pc: {
					mode: {{ sprintf('%J', wallpaper.pc?.mode ?? 'random') }},
					url: {{ sprintf('%J', wallpaper.pc?.url ?? '') }},
					proxy: {{ sprintf('%J', wallpaper.pc?.proxy ?? '') }},
					sources: {{ sprintf('%J', wallpaper.pc?.sources ?? []) }}
				},
				mobile: {
					mode: {{ sprintf('%J', wallpaper.mobile?.mode ?? 'random') }},
					url: {{ sprintf('%J', wallpaper.mobile?.url ?? '') }},
					proxy: {{ sprintf('%J', wallpaper.mobile?.proxy ?? '') }},
					sources: {{ sprintf('%J', wallpaper.mobile?.sources ?? []) }}
				}
			};
		</script>
		<script>
			/* Shared wallpaper helper (review TZ-14): the single UA/API
			   definition used by menu-mint.js (admin pages) and the
			   sysauth view (login page). */
			window.mzWpUtil = {
				isMobileUA: function() {
					return /Android|iPhone|iPad|iPod|Mobile|Windows Phone|WebOS|BlackBerry|Opera Mini|IEMobile/i.test(navigator.userAgent || '');
				},
				/* ----- Cache-busting version ---------------------------------
				   The backend stamps every local wallpaper URL with ?v=<mtime>
				   (see wallpaper.uc#withVersion), which covers an overwrite of
				   the same file. It does NOT cover "the user re-selected a
				   different entry that happens to share a URL" or "the browser
				   cached the image before the cron job rewrote it" - in both
				   cases the URL is byte-identical while the expected picture
				   changed. The settings page therefore bumps a client-side
				   version on every apply / upload / delete / force-refresh and
				   every wallpaper URL carries it, so a changed selection can
				   never be served from cache. Normal caching is untouched: the
				   stamp only changes when the user changes something. */
				version: function() {
					try { return localStorage.getItem('mz-wp-ver') || '0'; }
					catch (e) { return '0'; }
				},
				bumpVersion: function() {
					var v = String(Date.now());
					try { localStorage.setItem('mz-wp-ver', v); } catch (e) {}
					return v;
				},
				stamp: function(url) {
					if (!url || typeof url !== 'string') return url;
					var v = this.version();
					if (!v || v === '0') return url;
					return url + (url.indexOf('?') >= 0 ? '&' : '?') + '_mzv=' + v;
				},
				/* Drop the 5-minute session cache so a new selection is not
				   shadowed by the previously remembered URL. */
				dropSessionCache: function(mobile) {
					try {
						sessionStorage.removeItem('mz-wp-url-' + (mobile ? 'mobile' : 'pc'));
						sessionStorage.removeItem('mz-wp-url-' + (mobile ? 'pc' : 'mobile'));
					} catch (e) {}
				},
				/* Preload, then paint. Without this the CSS variable flips
				   before the new image has decoded and the browser keeps
				   showing the previous picture for a frame - or forever, if
				   the new URL 304s from a stale cache entry. */
				apply: function(url, done) {
					var self = this;
					if (!url) {
						document.documentElement.style.removeProperty('--mz-wallpaper');
						if (done) done(false);
						return;
					}
					var target = self.stamp(url);
					var img = new Image();
					var settled = false;
					var finish = function(ok) {
						if (settled) return;
						settled = true;
						if (done) done(ok);
					};
					img.referrerPolicy = 'no-referrer';
					img.onload = function() {
						document.body.classList.add('mz-wp-swapping');
						document.documentElement.style.setProperty('--mz-wallpaper', 'url("' + target + '")');
						document.body.classList.add('mz-has-wallpaper');
						window.setTimeout(function() {
							document.body.classList.remove('mz-wp-swapping');
						}, 400);
						finish(true);
					};
					img.onerror = function() {
						/* Never leave a dead URL painted: fall back to the
						   gradient so the glass layer stays composed. */
						document.documentElement.style.removeProperty('--mz-wallpaper');
						finish(false);
					};
					img.src = target;
				},
				/* Pick one random source from the configured list; falls back
				   to the built-in per-device defaults when the list is empty. */
				randomUrl: function(mobile, sources) {
					var list = (sources && sources.length) ? sources
						: (mobile
							? ['https://api.seaya.link/wap', 'https://t.alcy.cc/mp']
							: ['https://api.paugram.com/wallpaper/', 'https://t.alcy.cc/bd']);
					var api = list[Math.floor(Math.random() * list.length)];
					return api + (api.indexOf('?') >= 0 ? '&' : '?') + '_mzt=' + Date.now();
				}
			};
		</script>
		{% if (wallpaper_error): %}
		{# R-06: entityencode - a raw backend message containing "-->" would
		    otherwise close this comment early and escape into page markup. #}
		<!-- mint wallpaper backend failed ({{ entityencode(wallpaper_error) }}); fell back to random APIs -->
		{% endif %}
	</head>

	<body class="lang_{{ dispatcher.lang }}" data-page="{{ entityencode(join('-', length(ctx.request_path) ? ctx.request_path : ctx.path), true) }}">
		{% if (!blank_page): %}
		<a class="mz-skip-link" href="#maincontent">{{ _('Skip to main content') }}</a>

		<button type="button" id="mz-sidebar-toggle" class="mz-sidebar-toggle" aria-label="{{ _('Toggle navigation menu') }}" aria-expanded="false" aria-controls="mz-sidebar">
			<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
		</button>
		<div id="mz-overlay" class="mz-overlay" hidden></div>

		<aside id="mz-sidebar" class="mz-sidebar" aria-label="{{ _('Main navigation') }}">
			<div class="mz-brand">
				<a href="/" class="mz-brand-link">
					<img src="{{ media }}/overview-banner.png" alt="Mint" class="mz-brand-logo">
				</a>
			</div>

			<nav class="mz-nav" aria-label="{{ _('Menu') }}">
				<ul id="mainmenu" class="mz-menu" style="display:none"></ul>
			</nav>

			<div class="mz-sidebar-footer">
				<div class="mz-sidebar-actions">
					<a href="{{ dispatcher.build_url('admin/system/system') }}" class="mz-icon-btn" title="{{ _('System') }}" aria-label="{{ _('System') }}">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h0a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h0a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v0a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
					</a>
					<button type="button" class="mz-icon-btn" id="mz-theme-toggle" title="{{ _('Switch color scheme') }}" aria-label="{{ _('Switch color scheme') }}">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72 1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
					</button>
					<a href="#" class="mz-icon-btn" id="mz-logout" title="{{ _('Log out') }}" aria-label="{{ _('Log out') }}">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
					</a>
				</div>
			</div>
		</aside>

		<div class="mz-main" id="maincontent">
			{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
				<div class="alert-message warning" role="alert">
					<h4>{{ _('No password set!') }}</h4>
					<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
					{% if (dispatcher.lookup("admin/system/admin")): %}
					  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
					{% endif %}
				</div>
			{% endif %}

			{% if (boardinfo.rootfs_type == "initramfs"): %}
				<div class="alert-message warning" role="alert">
					<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
					<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
					{% if (dispatcher.lookup("admin/system/flash")): %}
					  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
					{% endif %}
				</div>
			{% endif %}

			<noscript>
				<div class="alert-message warning" role="alert">
					<h4>{{ _('JavaScript required!') }}</h4>
					<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
				</div>
			</noscript>

			{#
			  Page title bar. Desktop hides it (the view's own <h2> already
			  names the page and the extra strip was pure redundancy);
			  phones keep it. See the .mz-topbar rules in cascade.css.
			#}
			<header class="mz-topbar">
				<span class="mz-topbar-title" id="mz-topbar-title" aria-live="polite"></span>
			</header>

			{#
			  The LuCI indicator slot lives in its OWN container rather than
			  inside .mz-topbar. ui.js#showIndicator() mounts into
			  #indicators and LuCI renders the change/apply indicator and the
			  XHR poll badge there; leaving it inside a header that desktop
			  now hides would silently remove those native affordances.
			  The id MUST stay exactly "indicators" - that is the selector
			  LuCI itself queries. The container collapses to zero height
			  while the slot is empty, so it costs no layout space.
			#}
			<div class="mz-indicatorbar">
				<div id="indicators" class="mz-indicators" aria-live="polite"></div>
			</div>

			<main id="mz-view" class="mz-view">
				<div id="tabmenu" style="display:none"></div>
			{% endif %}
