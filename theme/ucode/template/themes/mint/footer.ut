		{# Asset cache revision. footer.ut is a separate ucode template, so it
		   cannot see header.ut's constant: keep this in sync with the
		   MINT_ASSET_REV in header.ut AND the ?v= of the @import lines in
		   cascade.css. Bump whenever any file under htdocs/luci-static/mint
		   changes. #}
		{% const MINT_ASSET_REV = '20260913k'; %}

		{% if (!blank_page): %}
			</main>

			<footer class="mz-footer">
				<span>
					{# i18n: the theme's own footer text. Kept as a msgid so the
					    zh_Hans po supplies 由 … 提供支持 while other locales
					    keep their own wording. #}
					{{ _('Powered by') }}
					<a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">
						{{ version.luciname }} ({{ version.luciversion }})</a>
					/
					<a href="{{ entityencode(version.disturl ?? '#', true) }}" target="_blank" rel="noreferrer">
						{{ version.distname }} {{ version.distversion }} ({{ version.distrevision }})</a>
					<span class="mz-footer-sep">|</span>
					<a href="https://github.com/LianXia233/luci-theme-mint" target="_blank" rel="noreferrer" class="mz-footer-brand">mint</a>
				</span>
			</footer>
		</div>
		<script>
		/*
		 * Stamp the theme's OWN class modules with the theme revision.
		 *
		 * L.require() builds each module URL as
		 *     <resource>/<name>.js?v=<env.resource_version>
		 * and LuCI takes env.resource_version from the ?v= on ITS OWN
		 * luci.js <script> tag - the LuCI build string, NOT this theme's
		 * revision. menu-mint.js and resources/view/mint/*.js were
		 * therefore cached under a key that never changed when the theme
		 * did, so a browser could keep running the previous build after an
		 * upgrade. That is exactly how the OLD sysauth.js - which still
		 * fetched the cron-cached random wallpaper onto the login page -
		 * survived alongside the new character backdrop and showed
		 * through it.
		 *
		 * L.env IS the very object require() reads (the LuCI class exposes
		 * the module-closure env), so re-stamping it here makes every
		 * module required from now on carry the theme revision. It is
		 * deliberately emitted BEFORE the first theme require and never
		 * restored: a view module is required after DOMContentLoaded, i.e.
		 * after this script has run.
		 *
		 * LuCI's own modules are unaffected in practice - ui / rpc / form /
		 * validation / uci / fs are already in the class registry by now,
		 * and anything loaded later is simply fetched under the new
		 * revision once.
		 */
		(function () {
			var meta = document.querySelector('meta[name="mz-asset-rev"]');
			var rev = meta && meta.getAttribute('content');
			if (rev && window.L && L.env && L.env.resource_version !== rev)
				L.env.resource_version = rev;
		})();
		</script>
		<script>L.require('menu-mint')</script>
		<script src="{{ media }}/mz-ui.js?v={{ MINT_ASSET_REV }}" defer></script>
		{% if (join('-', length(ctx.request_path) ? ctx.request_path : ctx.path) == 'admin-status-overview'): %}
		<link rel="stylesheet" href="{{ media }}/overview-dashboard.css?v={{ MINT_ASSET_REV }}" />
		<script>
		(function () {
			/* One dashboard for every device (2026-09-11): phones previously
			   got the compact overview-mobile.js renderer, which never showed
			   the gauges / charts / upstream cards the desktop dashboard has.
			   overview-dashboard.css already ships 1199px / 767px / 420px
			   breakpoints (2- and 1-column grids), so the full dashboard is
			   used everywhere and the layout reflows per viewport.
			   overview-mobile.js stays in the package but is no longer booted. */
			var s = document.createElement('script');
			s.src = '{{ media }}/overview-dashboard.js?v={{ MINT_ASSET_REV }}';
			s.defer = true;
			(document.head || document.body).appendChild(s);
		})();
		</script>
		<script>
		(function () {
			/* Dedup (CHANGELOG): the theme dashboard re-renders System / Memory /
			   Storage on top of the stock LuCI overview. Hide the stock blocks so
			   the summary is shown exactly once; the remaining stock sections
			   (Ports / Network / DHCP / Wireless / UPnP) stay intact.
			   The stock sections are injected client-side by LuCI and its collapse
			   logic overwrites inline display, so hide via a CSS class with
			   !important instead of inline style.display. */
			function mintEnsureStyle() {
				if (window.__mintDedupStyle) return true;
				if (!document.head) return false;
				var st = document.createElement('style');
				st.textContent = '.mint-dedup-hidden{display:none!important}';
				document.head.appendChild(st);
				window.__mintDedupStyle = true;
				return true;
			}
			function mintDedupOverview() {
				if (window.__mintDedupDone) return false;
				if (!mintEnsureStyle()) return false;
				var hid = false;
				document.querySelectorAll('.cbi-section').forEach(function (sec) {
					var h = sec.querySelector('h3');
					if (!h) return;
					var t = (h.textContent || '').replace(/[\u200b\s]+/g, ' ').trim();
					if (t.indexOf('系统') === 0 || t.indexOf('内存') === 0 || t.indexOf('存储') === 0 ||
						t.indexOf('System') === 0 || t.indexOf('Memory') === 0 || t.indexOf('Storage') === 0) {
						if (sec.className.indexOf('mint-dedup-hidden') < 0)
							sec.className += ' mint-dedup-hidden';
						hid = true;
					}
				});
				if (hid) window.__mintDedupDone = true;
				return hid && window.__mintDedupDone;
			}
			try {
				if (window.MutationObserver) {
					var mo = new MutationObserver(function () {
						if (mintDedupOverview()) mo.disconnect();
					});
					mo.observe(document.documentElement, { childList: true, subtree: true });
				}
			} catch (e) { /* opt-in, never break the page */ }
			var tries = 0;
			var timer = setInterval(function () {
				if (mintDedupOverview() || ++tries > 60) clearInterval(timer);
			}, 300);
			if (document.readyState !== 'loading') mintDedupOverview();
			else document.addEventListener('DOMContentLoaded', mintDedupOverview);
			window.addEventListener('load', mintDedupOverview);
		})();
		</script>
		{% endif %}
		{% if (join('-', length(ctx.request_path) ? ctx.request_path : ctx.path) == 'admin-status-nftables'): %}
		<script src="{{ media }}/mz-nftables.js?v={{ MINT_ASSET_REV }}" defer></script>
		{% endif %}
		{% endif %}
	</body>
</html>
