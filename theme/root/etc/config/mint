# mint wallpaper configuration
# Read by the ucode wallpaper backend; see /usr/share/ucode/luci/mint/

config mint 'wallpaper'
	option enabled '1'
	# Random wallpaper on admin pages (in addition to the login page)
	option ui_random '1'
	# Desktop source: 'random' (Paugram API) or 'custom'
	option pc_mode 'random'
	# Desktop custom image: direct http(s) link (an uploaded custom-pc.jpg wins)
	option pc_url ''
	# Mobile source: 'random' (Seaya ACG API) or 'custom'
	option mobile_mode 'random'
	# Mobile custom image: direct http(s) link (an uploaded custom-mobile.jpg wins)
	option mobile_url ''
	# Dark overlay opacity over the wallpaper (0.0 - 1.0)
	option overlay '0.45'
	# Background blur in px (0 = disabled, max 40)
	option blur '0'
