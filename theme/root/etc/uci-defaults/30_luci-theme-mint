#!/bin/sh
# uci-defaults script for luci-theme-mint
# Registers the theme variants in luci.themes and activates the theme on
# fresh installs. The theme keys are package-owned and rewritten on every
# install/upgrade; the user's active theme (luci.main.mediaurlbase) is
# only touched on fresh installs.

# Each variant gets its own mediaurlbase so that the LuCI theme selector
# can switch between them: header/footer/sysauth templates are looked up
# under themes/$(basename mediaurlbase)/, and htdocs/luci-static/ plus
# ucode/template/themes/ provide mint-light / mint-dark symlinks
# pointing to the mint originals.
# NOTE: UCI option names may only contain [a-zA-Z0-9_]; hyphens (e.g.
# "mint-light") make uci set fail with uci: Parse error, so the
# registered keys use CamelCase while the mediaurlbase values keep the
# hyphenated symlink paths.
# Only write a key that is missing (upstream bootstrap/material convention).
# Unconditional `uci set` + `uci commit` rewrites /etc/config/luci on every
# install/upgrade for no reason and makes "did the admin change this?"
# impossible to answer afterwards.
changed=0
set_opt() {
	if ! uci -q get "luci.$1" >/dev/null 2>&1; then
		uci set "luci.$1=$2"
		changed=1
	fi
}

set_opt themes.mint /luci-static/mint
set_opt themes.MintLight /luci-static/mint-light
set_opt themes.MintDark /luci-static/mint-dark

# Remove stale ACL files left in the legacy luci acl.d directory by older
# builds. The theme now ships ACLs in /usr/share/rpcd/acl.d/; a leftover
# file here can override rpcd grants and break wallpaper settings.
rm -f /usr/share/luci/acl.d/luci-theme-mint.json
rm -f /usr/share/luci/acl.d/luci-theme-mintzero.json

# Migrate the pre-rename (luci-theme-mintzero) wallpaper configuration so
# upgrades keep their custom images/URLs. The old section is only moved
# when no new 'mint' section exists yet, so a fresh config is never
# overwritten. Uploaded images are moved along (if still present).
if uci -q get mintzero.wallpaper >/dev/null 2>&1 && ! uci -q get mint.wallpaper >/dev/null 2>&1; then
	for _opt in enabled ui_random pc_mode pc_url mobile_mode mobile_url overlay blur; do
		_val=$(uci -q get mintzero.wallpaper.$_opt 2>/dev/null)
		[ -n "$_val" ] && uci -q set mint.wallpaper.$_opt="$_val"
	done
	uci -q delete mintzero.wallpaper
	rm -f /etc/config/mintzero
	for _img in custom-pc.jpg custom-mobile.jpg; do
		[ -f "/www/luci-static/mintzero/$_img" ] && mv -f "/www/luci-static/mintzero/$_img" "/www/luci-static/mint/$_img"
	done
fi

# Wallpaper defaults for the mint UCI section. Only written when the
# section does not exist yet, so user config survives upgrades.
if ! uci -q get mint.wallpaper 2>/dev/null; then
	uci -q set mint.wallpaper=mint 2>/dev/null || {
		[ -f /etc/config/mint ] || touch /etc/config/mint
		uci set mint.wallpaper=mint
	}
	uci -q set mint.wallpaper.enabled=1
	uci -q set mint.wallpaper.ui_random=1
	uci -q set mint.wallpaper.pc_mode=random
	uci -q set mint.wallpaper.mobile_mode=random
	uci -q set mint.wallpaper.overlay=0.45
	uci -q set mint.wallpaper.blur=0
	# Random multi-source defaults (empty list -> backend built-ins)
	uci -q add_list mint.wallpaper.pc_sources='https://api.paugram.com/wallpaper/'
	uci -q add_list mint.wallpaper.pc_sources='https://t.alcy.cc/bd'
	uci -q add_list mint.wallpaper.mobile_sources='https://api.seaya.link/wap'
	uci -q add_list mint.wallpaper.mobile_sources='https://t.alcy.cc/mp'
fi

# Drop obsolete pre-2026-09-07 keys (Bing era) so upgrades don't accumulate
# dead options (review TZ-17 / OT-29).
for _opt in market cache_ttl random mode count; do
	uci -q delete mint.wallpaper.$_opt
done

# OT-35: install the server-side wallpaper cache refresher (cron, every 5
# minutes). Idempotent: the marker comment keeps us from adding a second
# line on upgrades; user cron entries are preserved.
if [ -f /etc/crontabs/root ] && grep -q 'mz-wallpaper-fetch' /etc/crontabs/root; then
	: # already installed
else
	echo '*/5 * * * * /usr/bin/mz-wallpaper-fetch.sh #mz-wallpaper' >> /etc/crontabs/root
	/etc/init.d/cron restart >/dev/null 2>&1 || true
fi

if [ "$PKG_UPGRADE" != 1 ] && [ "$changed" = 1 ]; then
	uci -q set luci.main.mediaurlbase=/luci-static/mint
fi

# Rename fallback: a stale mintzero mediaurlbase (left over from the
# pre-rename package) points at a path that no longer exists, which makes
# CSS/JS 404 and the theme fall back. Rewrite it to the new path.
_mzbase=$(uci -q get luci.main.mediaurlbase 2>/dev/null)
case "$_mzbase" in
	*/mintzero-dark)  uci -q set luci.main.mediaurlbase=/luci-static/mint-dark ;;
	*/mintzero-light) uci -q set luci.main.mediaurlbase=/luci-static/mint-light ;;
	*/mintzero)       uci -q set luci.main.mediaurlbase=/luci-static/mint ;;
esac

uci commit luci
uci commit mint

exit 0
