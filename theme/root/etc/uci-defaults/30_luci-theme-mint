#!/bin/sh
# uci-defaults script for luci-theme-mint
# Registers the theme variant in luci.themes and activates the theme on fresh
# installs. The theme keys are package-owned and rewritten on every
# install/upgrade; the user's active theme (luci.main.mediaurlbase) is only
# touched on fresh installs.
#
# 2026-09-11: everything that WRITES the wallpaper configuration (uci
# defaults, /etc/config/mint, the cache cron) moved to
# luci-app-mint-wallpaper. What stays here is theme registration plus the
# cleanup of the files that moved, so an upgrade cannot leave a duplicate
# menu entry or a stale ACL grant behind.

# The theme ships a single "Mint" variant. Light/dark is handled by the
# sidebar toggle (data-theme) inside that variant, so no extra
# mint-light / mint-dark UCI registrations are needed.
# NOTE: UCI option names may only contain [a-zA-Z0-9_]; hyphens (e.g.
# "mint-light") make uci set fail with uci: Parse error.
# Only write a key that is missing (upstream bootstrap/material convention).
# Unconditional `uci set` + `uci commit` rewrites /etc/config/luci on every
# install/upgrade for no reason and makes "did the admin change this?"
# impossible to answer afterwards.
changed=0
set_opt() {
	if ! uci -q get "luci.$1" >/dev/null 2>&1; then
		uci set "luci.$1=$2"
		changed=1
	fi
}

set_opt themes.mint /luci-static/mint

# Remove the removed theme variants (including old mintzero spellings).
uci -q delete luci.themes.MintLight
uci -q delete luci.themes.MintDark
uci -q delete luci.themes.MintzeroLight
uci -q delete luci.themes.MintzeroDark

# Remove stale ACL files left in the legacy luci acl.d directory by older
# builds. The theme now ships ACLs in /usr/share/rpcd/acl.d/; a leftover file
# here can override rpcd grants and break wallpaper settings.
rm -f /usr/share/luci/acl.d/luci-theme-mint.json
rm -f /usr/share/luci/acl.d/luci-theme-mintzero.json

# The wallpaper registrations now belong to luci-app-mint-wallpaper. Delete
# the ones this package used to ship, so a plain theme upgrade cannot leave
# BOTH a stale "Mint Wallpaper" entry under System AND the app's new
# top-level one.
rm -f /usr/share/rpcd/acl.d/luci-theme-mint.json
rm -f /usr/share/luci/menu.d/luci-theme-mint.json

if [ "$PKG_UPGRADE" != 1 ] && [ "$changed" = 1 ]; then
	uci -q set luci.main.mediaurlbase=/luci-static/mint
fi

# Stale variant mediaurlbases no longer exist. Rewrite them all to the single
# Mint variant so CSS/JS never 404 and the theme still loads.
_mzbase=$(uci -q get luci.main.mediaurlbase 2>/dev/null)
case "$_mzbase" in
	*/mint-dark|*/mint-light|*/mintzero-dark|*/mintzero-light|*/mintzero) 		uci -q set luci.main.mediaurlbase=/luci-static/mint ;;
esac

uci commit luci

exit 0
