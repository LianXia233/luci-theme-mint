{
	"luci-app-mint-wallpaper": {
		"description": "Grant access to the Mint wallpaper settings (uci mint, rpcd mint save/wp_*, cgi-upload of wallpapers)",
		"read": {
			"ubus": {
				"mint": [
					"refresh",
					"dashboard",
					"wp_list",
					"wp_refresh"
				]
			},
			"uci": [
				"mint"
			],
			"file": {
				"/www/luci-static/mint": [
					"list"
				],
				"/www/luci-static/mint/*": [
					"read"
				],
				"/www/luci-static/mint/wallpapers": [
					"list"
				],
				"/www/luci-static/mint/wallpapers/*": [
					"read"
				]
			}
		},
		"write": {
			"ubus": {
				"mint": [
					"save",
					"wp_delete",
					"wp_set",
					"wp_refresh"
				],
				"cgi-io": [
					"upload"
				]
			},
			"uci": [
				"mint"
			],
			"file": {
				"/www/luci-static/mint/custom-pc.jpg": [
					"write"
				],
				"/www/luci-static/mint/custom-mobile.jpg": [
					"write"
				],
				"/www/luci-static/mint/wallpapers/*": [
					"write"
				]
			}
		}
	}
}
