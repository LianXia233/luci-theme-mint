{
	"luci-app-mint-wallpaper": {
		"description": "Grant access to the Mint wallpaper settings (uci mint, rpcd mint save/refresh/dashboard)",
		"read": {
			"ubus": {
				"mint": [
					"refresh",
					"dashboard"
				]
			},
			"uci": [
				"mint"
			],
			"file": {
				"/www/luci-static/mint": [
					"list"
				]
			}
		},
		"write": {
			"ubus": {
				"mint": [
					"save"
				]
			},
			"uci": [
				"mint"
			],
			"file": {
				"/www/luci-static/mint/custom-pc.jpg": [
					"write"
				],
				"/www/luci-static/mint/custom-mobile.jpg": [
					"write"
				]
			}
		}
	}
}
