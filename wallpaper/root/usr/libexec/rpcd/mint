#
# Methods:
#   refresh   - force-refresh the server-side random wallpaper cache by
#               re-running mz-wallpaper-fetch.sh (blocking, bounded).
#   dashboard - real-time system telemetry collector for the Mint Overview
#               Dashboard. Reads /proc, /sys, ubus and emits a single JSON
#               snapshot. The browser (overview-dashboard.js) computes
#               percentages / rates / deltas from the raw counters, so this
#               script stays a pure, stateless collector.
#   save      - persist CBI form values to UCI and commit (see mint_save).
#   wp_list   - list wallpapers in the library + current selections.
#   wp_delete - remove one user wallpaper; falls back to random if current.
#   wp_set    - set the current wallpaper (library name, 'random', or clear).
#   wp_refresh- alias of refresh (settings-page button).
#
# Upload is intentionally NOT done here: the browser POSTs multipart data to
# LuCI's official /cgi-bin/cgi-upload (cgi-io), which authenticates the
# session and streams the body to disk. Pushing multi-megabyte base64 through
# ubus either hits message limits or (on rpcd builds that do not base64-
# decode file.write) writes the base64 text itself as the "image".

mint_save() {
	read -r req
	config=$(printf '%s' "$req" | jsonfilter -e '@.config' 2>/dev/null)
	section=$(printf '%s' "$req" | jsonfilter -e '@.section' 2>/dev/null)
	# sanitise config / section to safe charset only
	case "$config$section" in
		*[!A-Za-z0-9_]*) echo '{"error":"invalid config or section"}'; return ;;
	esac
	[ -z "$config" ] && { echo '{"error":"missing config"}'; return; }
	[ -z "$section" ] && { echo '{"error":"missing section"}'; return; }
	i=0
	written=0
	while :; do
		kv=$(printf '%s' "$req" | jsonfilter -e "@.values[$i]" 2>/dev/null)
		[ -z "$kv" ] && break
		k=$(printf '%s' "$kv" | jsonfilter -e '@[0]' 2>/dev/null)
		v=$(printf '%s' "$kv" | jsonfilter -e '@[1]' 2>/dev/null)
		case "$k" in
			*[!A-Za-z0-9_]*) i=$((i+1)); continue ;;
		esac
		[ -z "$k" ] && { i=$((i+1)); continue; }
		uci set "$config.$section.$k=$v" 2>/dev/null && written=$((written+1))
		i=$((i+1))
	done
	if [ "$written" -gt 0 ]; then
		uci commit "$config" 2>/dev/null
		# Audit trail: every committed write is logged with the option
		# names (values may contain secrets, so only keys are logged).
		keys=""
		i2=0
		while :; do
			kv=$(printf '%s' "$req" | jsonfilter -e "@.values[$i2]" 2>/dev/null)
			[ -z "$kv" ] && break
			k=$(printf '%s' "$kv" | jsonfilter -e '@[0]' 2>/dev/null)
			case "$k" in *[!A-Za-z0-9_]*) i2=$((i2+1)); continue ;; esac
			[ -n "$k" ] && keys="$keys $k"
			i2=$((i2+1))
		done
		logger -t mint-save "commit $config.$section:$keys"
	fi
	printf '{"ok":true,"written":%s,"config":"%s","section":"%s"}\n' "$written" "$config" "$section"
}

# Public (exit) IPv4, fetched from ipv4.im.
#   - Cached 5 min so the per-second poll never hammers the service.
#   - On failure we retry a couple of times; if still down we report
#     "未联网" (offline) and stop probing immediately.
#   - After too many failures we back off: we only re-fetch once a ping
#     probe to a public host succeeds, so we don't keep hitting the
#     network while it is clearly down.
mint_public_ip() {
	cache=/tmp/mint_public_ip
	failf=/tmp/mint_public_ip_fail
	maxfail=3
	now=$(date +%s 2>/dev/null)

	# Reuse a fresh good cache (<5 min) without probing the network.
	if [ -n "$now" ] && [ -f "$cache" ]; then
		cts=$(awk 'NR==1{print $2}' "$cache" 2>/dev/null)
		if [ -n "$cts" ] && [ $((now - cts)) -lt 300 ]; then
			awk 'NR==1{print $1}' "$cache" 2>/dev/null
			return
		fi
	fi

	# Backoff: too many recent failures -> only retry after a connectivity
	# probe (ping) to a public host succeeds, so we stop probing while down.
	if [ -f "$failf" ]; then
		fc=$(cat "$failf" 2>/dev/null)
		if [ -n "$fc" ] && [ "$fc" -ge "$maxfail" ]; then
			if ! ping -c1 -W2 223.5.5.5 >/dev/null 2>&1 && ! ping -c1 -W2 119.29.29.29 >/dev/null 2>&1; then
				echo "未联网"
				return
			fi
			rm -f "$failf"
		fi
	fi

	# Fetch with retries (1s apart) before giving up. R-10: keep the worst
	# case short (~5s: 2 x 2s + 1s sleep) - a hung WAN must not stall the
	# whole dashboard RPC for ~11s on every poll.
	ip=""
	for _i in 1 2; do
		ip=$(curl -s --max-time 2 ipv4.im 2>/dev/null | tr -d '\r\n ')
		if [ -n "$ip" ] && printf '%s' "$ip" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
			break
		fi
		ip=""
	sleep 1
	done

	if [ -n "$ip" ]; then
		rm -f "$failf"
		printf '%s %s\n' "$ip" "$now" > "$cache" 2>/dev/null
		printf '%s' "$ip"
	else
		if [ -f "$failf" ]; then
			fc=$(cat "$failf" 2>/dev/null); fc=$((fc + 1))
		else
			fc=1
		fi
		printf '%s' "$fc" > "$failf" 2>/dev/null
		echo "未联网"
	fi
}

# Escape a value for safe embedding inside a JSON string literal (R-05).
# Hostnames, model strings and interface values are operator-controlled and
# may contain '"', '\' or control characters that would otherwise break the
# hand-assembled JSON below (and, in the worst case, alter its structure).
# sed escapes the two JSON metacharacters; tr strips C0 control characters
# (tab/newline included), which keeps the output single-line and valid.
json_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\000-\037'
}

mint_dashboard() {
	# ---- CPU (raw counters; frontend computes usage delta) ----
	cpu_stat=$(head -1 /proc/stat 2>/dev/null)
	cores=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)
	[ -z "$cores" ] && cores=0
	freq=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null)
	[ -z "$freq" ] && freq=$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_cur_freq 2>/dev/null)

	# ---- Memory ----
	mem_total=$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null)
	mem_avail=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo 2>/dev/null)
	mem_free=$(awk '/^MemFree:/{print $2}' /proc/meminfo 2>/dev/null)
	mem_buffers=$(awk '/^Buffers:/{print $2}' /proc/meminfo 2>/dev/null)
	mem_cached=$(awk '/^Cached:/{print $2}' /proc/meminfo 2>/dev/null)

	# ---- Temperature (scan thermal zones + hwmon; millidegrees) ----
	temps=""
	add_temp() {
		[ -z "$2" ] && return
		name_esc="$(json_escape "$1")"
		if [ -z "$temps" ]; then
			temps="{\"name\":\"$name_esc\",\"temp_mc\":$2}"
		else
			temps="$temps,{\"name\":\"$name_esc\",\"temp_mc\":$2}"
		fi
	}
	for z in /sys/class/thermal/thermal_zone*/type; do
		[ -f "$z" ] || continue
		name=$(cat "$z" 2>/dev/null)
		idx=${z#/sys/class/thermal/thermal_zone}
		idx=${idx%/type}
		tf="/sys/class/thermal/thermal_zone$idx/temp"
		[ -f "$tf" ] || continue
		add_temp "$name" "$(cat "$tf" 2>/dev/null)"
	done
	for h in /sys/class/hwmon/hwmon*/; do
		[ -d "$h" ] || continue
		hn=$(cat "${h}name" 2>/dev/null)
		for f in "$h"*_input; do
			[ -f "$f" ] || continue
			b=${f#"$h"}
			lbl=${b%_input}
			case "$lbl" in
				temp*) add_temp "${hn}_${lbl}" "$(cat "$f" 2>/dev/null)" ;;
			esac
		done
	done
	if [ -z "$temps" ]; then
		temps_json="[]"
	else
		temps_json="[$temps]"
	fi

	# ---- Storage (real writable layer at /) ----
	storage_line=$(df -k / 2>/dev/null | awk 'NR==2')
	fs=$(echo "$storage_line" | awk '{print $1}')
	stotal=$(echo "$storage_line" | awk '{print $2}')
	sused=$(echo "$storage_line" | awk '{print $3}')
	savail=$(echo "$storage_line" | awk '{print $4}')
	spct=$(echo "$storage_line" | awk '{gsub(/%/,"",$5); print $5}')
	if [ -n "$stotal" ]; then
		storage_json=$(printf '{"filesystem":"%s","total_kb":%s,"used_kb":%s,"avail_kb":%s,"use_pct":%s,"mount":"/"}' \
			"$(json_escape "$fs")" "$stotal" "$sused" "$savail" "${spct:-0}")
	else
		storage_json="null"
	fi

	# ---- Load / Uptime / Conntrack ----
	read l1 l5 l15 _rest < /proc/loadavg 2>/dev/null
	read up _idle < /proc/uptime 2>/dev/null
	cc=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null)
	cm=$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null)

	# ---- Network uplink (dynamic, never hard-coded) ----
	dump=$(ubus call network.interface dump 2>/dev/null)
	uplink_json="null"
	if [ -n "$dump" ]; then
		ifname=$(printf '%s' "$dump" | jsonfilter -e '@.interface[@.route[@.target="0.0.0.0"]].interface' 2>/dev/null | head -1)
		[ -z "$ifname" ] && ifname=$(printf '%s' "$dump" | jsonfilter -e '@.interface[@.route[@.target="::"]].interface' 2>/dev/null | head -1)
		if [ -n "$ifname" ]; then
			proto=$(printf '%s' "$dump" | jsonfilter -e "@.interface[@.interface=\"$ifname\"].proto" 2>/dev/null)
			dev=$(printf '%s' "$dump" | jsonfilter -e "@.interface[@.interface=\"$ifname\"].l3_device" 2>/dev/null)
			[ -z "$dev" ] && dev=$(printf '%s' "$dump" | jsonfilter -e "@.interface[@.interface=\"$ifname\"].device" 2>/dev/null)
			ipv4=$(printf '%s' "$dump" | jsonfilter -e "@.interface[@.interface=\"$ifname\"][\"ipv4-address\"][0].address" 2>/dev/null)
			ipv4m=$(printf '%s' "$dump" | jsonfilter -e "@.interface[@.interface=\"$ifname\"][\"ipv4-address\"][0].mask" 2>/dev/null)
			# IPv6 may live on a sibling interface that shares the same l3_device
			# (e.g. "wan" + "wan6"); fall back to any interface on the same device.
			ipv6=$(printf '%s' "$dump" | jsonfilter -e "@.interface[@.interface=\"$ifname\"][\"ipv6-address\"][0].address" 2>/dev/null)
			[ -z "$ipv6" ] && [ -n "$dev" ] && ipv6=$(printf '%s' "$dump" | jsonfilter -e "@.interface[@.l3_device=\"$dev\"][\"ipv6-address\"][0].address" 2>/dev/null | head -1)
			gw=$(printf '%s' "$dump" | jsonfilter -e "@.interface[@.interface=\"$ifname\"].route[@.target=\"0.0.0.0\"].nexthop" 2>/dev/null)
			[ -z "$gw" ] && gw=$(printf '%s' "$dump" | jsonfilter -e "@.interface[@.interface=\"$ifname\"].route[@.target=\"::\"].nexthop" 2>/dev/null)
			metric=$(printf '%s' "$dump" | jsonfilter -e "@.interface[@.interface=\"$ifname\"].metric" 2>/dev/null)
			rxb=""; txb=""
			if [ -n "$dev" ]; then
				rxb=$(cat /sys/class/net/$dev/statistics/rx_bytes 2>/dev/null)
				txb=$(cat /sys/class/net/$dev/statistics/tx_bytes 2>/dev/null)
			fi
			uplink_json=$(printf '{"name":"%s","device":"%s","proto":"%s","ipv4":"%s","ipv4_mask":%s,"ipv6":"%s","gateway":"%s","metric":%s,"rx_bytes":%s,"tx_bytes":%s}' \
				"$(json_escape "$ifname")" "$(json_escape "$dev")" "$(json_escape "$proto")" \
				"$(json_escape "$ipv4")" "${ipv4m:-null}" "$(json_escape "$ipv6")" "$(json_escape "$gw")" \
				"${metric:-null}" "${rxb:-null}" "${txb:-null}")
		fi
	fi

	# ---- Public (exit) IPv4 ----
	public_ip=$(mint_public_ip)

	# ---- System info ----
	board=$(ubus call system board 2>/dev/null)
	hostname=$(printf '%s' "$board" | jsonfilter -e '@.hostname' 2>/dev/null)
	model=$(printf '%s' "$board" | jsonfilter -e '@.model' 2>/dev/null)
	board_name=$(printf '%s' "$board" | jsonfilter -e '@.board_name' 2>/dev/null)
	system_arch=$(printf '%s' "$board" | jsonfilter -e '@.system' 2>/dev/null)
	target=$(printf '%s' "$board" | jsonfilter -e '@.release.target' 2>/dev/null)
	dist=$(printf '%s' "$board" | jsonfilter -e '@.release.distribution' 2>/dev/null)
	ver=$(printf '%s' "$board" | jsonfilter -e '@.release.version' 2>/dev/null)
	rev=$(printf '%s' "$board" | jsonfilter -e '@.release.revision' 2>/dev/null)
	kernel=$(printf '%s' "$board" | jsonfilter -e '@.kernel' 2>/dev/null)
	openwrt=$(. /etc/openwrt_release 2>/dev/null; printf '%s' "$DISTRIB_DESCRIPTION")
	luci_ver=$(grep '^luciversion' /usr/lib/lua/luci/version.lua 2>/dev/null | sed "s/.*= *//; s/[\"']//g")
	system_json=$(printf '{"hostname":"%s","model":"%s","board_name":"%s","arch":"%s","target":"%s","distribution":"%s","version":"%s","revision":"%s","kernel":"%s","openwrt":"%s","luci":"%s"}' \
		"$(json_escape "$hostname")" "$(json_escape "$model")" "$(json_escape "$board_name")" \
		"$(json_escape "$system_arch")" "$(json_escape "$target")" "$(json_escape "$dist")" \
		"$(json_escape "$ver")" "$(json_escape "$rev")" "$(json_escape "$kernel")" \
		"$(json_escape "$openwrt")" "$(json_escape "$luci_ver")")

	# ---- Assemble ----
	if [ -n "$cpu_stat" ]; then
		stat_json="\"$cpu_stat\""
	else
		stat_json="null"
	fi

	# ---- Network block (assembled here so the heredoc stays trivial) ----
	if [ -n "$public_ip" ]; then
		pub_json=$(printf '"%s"' "$(json_escape "$public_ip")")
	else
		pub_json=null
	fi
	network_json=$(printf '{"uplink":%s,"public_ipv4":%s}' "$uplink_json" "$pub_json")

	cat <<JSON
{
  "cpu": { "cores": $cores, "freq_khz": ${freq:-null}, "stat": $stat_json },
  "memory": { "total_kb": ${mem_total:-0}, "available_kb": ${mem_avail:-0}, "free_kb": ${mem_free:-0}, "buffers_kb": ${mem_buffers:-0}, "cached_kb": ${mem_cached:-0} },
  "temperature": $temps_json,
  "storage": $storage_json,
  "load": { "m1": ${l1:-0}, "m5": ${l5:-0}, "m15": ${l15:-0} },
  "uptime": ${up:-0},
  "conntrack": { "count": ${cc:-null}, "max": ${cm:-null} },
  "network": $network_json,
  "system": $system_json
}
JSON
}

# ---- wallpaper library ---------------------------------------------------

WP_DIR="/www/luci-static/mint/wallpapers"
WP_LEGACY_PC="/www/luci-static/mint/custom-pc.jpg"
WP_LEGACY_MOBILE="/www/luci-static/mint/custom-mobile.jpg"

# Accept only a plain file name (no slashes, no leading dot) with an image
# extension we actually store. Rejects path traversal before any touch.
wp_valid_name() {
	case "$1" in
		''|.*|*/*|*\\*) return 1 ;;
		*.jpg|*.jpeg|*.png|*.webp|*.gif|*.JPG|*.JPEG|*.PNG|*.WEBP|*.GIF) return 0 ;;
		*) return 1 ;;
	esac
}

wp_uci() {
	uci -q get "mint.wallpaper.$1" 2>/dev/null
}

# Emit one JSON object entry for a file in the library (no trailing comma).
wp_entry_json() {
	name="$1"
	path="$WP_DIR/$name"
	[ -f "$path" ] || return 1
	size=$(wc -c < "$path" 2>/dev/null); [ -n "$size" ] || size=0
	mtime=$(date -r "$path" +%s 2>/dev/null)
	[ -n "$mtime" ] || mtime=0
	name_esc=$(json_escape "$name")
	printf '{"name":"%s","size":%s,"mtime":%s,"url":"/luci-static/mint/wallpapers/%s?v=%s"}' \
		"$name_esc" "$size" "$mtime" "$name_esc" "$mtime"
}

mint_wp_list() {
	mkdir -p "$WP_DIR" 2>/dev/null

	pc_sel=$(wp_uci pc_wallpaper)
	mobile_sel=$(wp_uci mobile_wallpaper)
	pc_mode=$(wp_uci pc_mode); [ -n "$pc_mode" ] || pc_mode=random
	mobile_mode=$(wp_uci mobile_mode); [ -n "$mobile_mode" ] || mobile_mode=random
	pc_url=$(wp_uci pc_url); [ -n "$pc_url" ] || pc_url=""
	mobile_url=$(wp_uci mobile_url); [ -n "$mobile_url" ] || mobile_url=""
	enabled=$(wp_uci enabled); [ -n "$enabled" ] || enabled=1

	# Library files (sorted, stable order)
	items=""
	for f in "$WP_DIR"/*; do
		[ -f "$f" ] || continue
		bn=${f##*/}
		wp_valid_name "$bn" || continue
		ej=$(wp_entry_json "$bn") || continue
		if [ -z "$items" ]; then
			items="$ej"
		else
			items="$items,$ej"
		fi
	done

	# Server-side random cache thumbs (may be absent before first cron tick)
	pc_proxy_json="null"
	if [ -f /www/luci-static/mint/wallpaper-pc.img ]; then
		pc_proxy_json=$(json_escape "/luci-static/mint/wallpaper-pc.img?v=$(date -r /www/luci-static/mint/wallpaper-pc.img +%s 2>/dev/null || echo 0)")
		pc_proxy_json="\"$pc_proxy_json\""
	fi
	mobile_proxy_json="null"
	if [ -f /www/luci-static/mint/wallpaper-mobile.img ]; then
		mobile_proxy_json=$(json_escape "/luci-static/mint/wallpaper-mobile.img?v=$(date -r /www/luci-static/mint/wallpaper-mobile.img +%s 2>/dev/null || echo 0)")
		mobile_proxy_json="\"$mobile_proxy_json\""
	fi

	legacy_pc="null"
	[ -f "$WP_LEGACY_PC" ] && legacy_pc=true
	legacy_mobile="null"
	[ -f "$WP_LEGACY_MOBILE" ] && legacy_mobile=true

	printf '{"wallpapers":[%s],"current":{"pc_wallpaper":"%s","mobile_wallpaper":"%s","pc_mode":"%s","mobile_mode":"%s","pc_url":"%s","mobile_url":"%s","enabled":"%s"},"proxy":{"pc":%s,"mobile":%s},"legacy":{"pc":%s,"mobile":%s}}\n' \
		"$items" \
		"$(json_escape "$pc_sel")" "$(json_escape "$mobile_sel")" \
		"$(json_escape "$pc_mode")" "$(json_escape "$mobile_mode")" \
		"$(json_escape "$pc_url")" "$(json_escape "$mobile_url")" \
		"$(json_escape "$enabled")" \
		"$pc_proxy_json" "$mobile_proxy_json" \
		"$legacy_pc" "$legacy_mobile"
}

mint_wp_delete() {
	read -r req
	name=$(printf '%s' "$req" | jsonfilter -e '@.name' 2>/dev/null)
	if ! wp_valid_name "$name"; then
		echo '{"error":"invalid name"}'
		return
	fi
	path="$WP_DIR/$name"
	if [ ! -f "$path" ]; then
		echo '{"error":"not found"}'
		return
	fi
	rm -f "$path" || { echo '{"error":"unlink failed"}'; return; }

	# If this was the active wallpaper, fall back to random mode.
	changed=0
	if [ "$(wp_uci pc_wallpaper)" = "$name" ]; then
		uci -q delete mint.wallpaper.pc_wallpaper
		uci -q set mint.wallpaper.pc_mode=random
		changed=1
	fi
	if [ "$(wp_uci mobile_wallpaper)" = "$name" ]; then
		uci -q delete mint.wallpaper.mobile_wallpaper
		uci -q set mint.wallpaper.mobile_mode=random
		changed=1
	fi
	[ "$changed" -gt 0 ] && uci -q commit mint
	logger -t mint-wallpaper "deleted $name (reset=$changed)"
	printf '{"ok":true,"name":"%s","reset":%s}\n' "$(json_escape "$name")" "$([ "$changed" -gt 0 ] && echo true || echo false)"
}

mint_wp_set() {
	read -r req
	target=$(printf '%s' "$req" | jsonfilter -e '@.target' 2>/dev/null)   # pc | mobile
	value=$(printf '%s' "$req" | jsonfilter -e '@.value' 2>/dev/null)     # filename | random | clear
	case "$target" in
		pc|mobile) ;;
		*) echo '{"error":"invalid target"}'; return ;;
	esac

	case "$value" in
		random)
			uci -q delete "mint.wallpaper.${target}_wallpaper"
			uci -q delete "mint.wallpaper.${target}_url"
			uci -q set "mint.wallpaper.${target}_mode=random"
			uci -q commit mint
			printf '{"ok":true,"target":"%s","value":"random"}\n' "$target"
			;;
		clear)
			uci -q delete "mint.wallpaper.${target}_wallpaper"
			uci -q delete "mint.wallpaper.${target}_url"
			uci -q set "mint.wallpaper.${target}_mode=random"
			uci -q commit mint
			printf '{"ok":true,"target":"%s","value":"clear"}\n' "$target"
			;;
		*)
			if ! wp_valid_name "$value"; then
				echo '{"error":"invalid name"}'
				return
			fi
			if [ ! -f "$WP_DIR/$value" ]; then
				echo '{"error":"not found"}'
				return
			fi
			uci -q set "mint.wallpaper.${target}_wallpaper=$value"
			uci -q set "mint.wallpaper.${target}_mode=custom"
			# A library selection replaces any stale remote URL fallback.
			uci -q delete "mint.wallpaper.${target}_url"
			# cgi-io lands uploaded files as 600 root:root; relax so the
			# non-root uhttpd worker can serve the image (avoids HTTP 403).
			chmod 0644 "$WP_DIR/$value" 2>/dev/null
			uci -q commit mint
			logger -t mint-wallpaper "set $target -> $value"
			printf '{"ok":true,"target":"%s","value":"%s"}\n' "$target" "$(json_escape "$value")"
			;;
	esac
}

# Force-refresh the server-side random cache for ONE device class.
# Params (stdin JSON): { "kind": "pc"|"mobile" } — empty/missing kind is
# rejected so a stale UI can never accidentally rewrite both caches.
# The fetch script is invoked with the same kind filter; PC and mobile
# proxy files are never updated together by a manual refresh.
mint_wp_refresh() {
	read -r req
	kind=$(printf '%s' "$req" | jsonfilter -e '@.kind' 2>/dev/null)
	case "$kind" in
		pc|mobile) ;;
		*)
			echo '{"error":"kind must be pc or mobile"}'
			return
			;;
	esac

	if [ ! -x /usr/bin/mz-wallpaper-fetch.sh ]; then
		echo '{"error":"fetch script missing"}'
		return
	fi
	/usr/bin/mz-wallpaper-fetch.sh "$kind"

	f="/www/luci-static/mint/wallpaper-$kind.img"
	if [ -f "$f" ]; then
		mtime=$(date -r "$f" +%s 2>/dev/null || echo 0)
		printf '{"ok":true,"kind":"%s","mtime":%s,"url":"/luci-static/mint/wallpaper-%s.img?v=%s"}\n' \
			"$kind" "$mtime" "$kind" "$mtime"
	else
		printf '{"ok":true,"kind":"%s","mtime":null,"url":null}\n' "$kind"
	fi
}

case "$1" in
	list)
		echo '{"refresh":{},"dashboard":{},"save":{},"wp_list":{},"wp_delete":{},"wp_set":{},"wp_refresh":{}}'
		;;
	call)
		case "$2" in
			refresh|wp_refresh)
				mint_wp_refresh
				;;
			dashboard)
				mint_dashboard
				;;
			save)
				mint_save
				;;
			wp_list)
				mint_wp_list
				;;
			wp_delete)
				mint_wp_delete
				;;
			wp_set)
				mint_wp_set
				;;
			*)
				echo '{"error":"invalid method"}'
				;;
		esac
		;;
esac
exit 0
