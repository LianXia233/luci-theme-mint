# mint wallpaper configuration
# Read by the ucode wallpaper backend; see /usr/share/ucode/luci/mint/

config mint 'wallpaper'
	option enabled '1'
	# Random wallpaper on admin pages (in addition to the login page).
	# OFF by default (OT-09): the login page still gets a wallpaper; admin
	# pages only fetch a random image when the admin opts in here.
	option ui_random '0'
	# Desktop source: 'random' (multi-source) or 'custom'
	option pc_mode 'random'
	# Desktop library wallpaper (file name under /www/luci-static/mint/wallpapers/).
	# When set, it wins over pc_url and the random proxy cache.
	option pc_wallpaper ''
	# Desktop custom image: direct http(s) link (library / legacy upload wins)
	option pc_url ''
	# Desktop random sources: tried in random order; next one on failure
	list pc_sources 'https://api.paugram.com/wallpaper/'
	list pc_sources 'https://t.alcy.cc/bd'
	# Mobile source: 'random' (multi-source) or 'custom'
	option mobile_mode 'random'
	# Mobile library wallpaper (same rules as pc_wallpaper)
	option mobile_wallpaper ''
	# Mobile custom image: direct http(s) link (library / legacy upload wins)
	option mobile_url ''
	# Mobile random sources: tried in random order; next one on failure
	list mobile_sources 'https://api.seaya.link/wap'
	list mobile_sources 'https://t.alcy.cc/mp'
	# Dark overlay opacity over the wallpaper (0.0 - 1.0)
	option overlay '0.45'
	# Background blur in px (0 = disabled, max 40)
	option blur '0'
